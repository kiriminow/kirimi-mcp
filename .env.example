# Kirimi API credentials. Both are required.
# Dashboard -> Credentials (NOT an "API key" — the API takes user_code + secret).
KIRIMI_USER_CODE=your_user_code_here
KIRIMI_SECRET=your_secret_here

# Optional: default device for device-scoped tools (send_message, device_status, ...).
KIRIMI_DEVICE_ID=D-XXXXX

# Optional overrides.
KIRIMI_API_BASE_URL=https://api.kirimi.id
KIRIMI_TIMEOUT_MS=30000
